---
import { type Locale } from '../i18n/locales';
import { t } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const translate = t(locale);
---

<footer class="border-t border-line">
  <div class="mx-auto flex max-w-6xl flex-col gap-2 px-5 py-8 text-sm text-muted sm:flex-row sm:items-center sm:justify-between sm:px-8">
    <p>&copy; {new Date().getFullYear()} Breyner Ciro. {translate('footer.rights')}</p>
    <p>{translate('footer.built')} Astro + Tailwind CSS</p>
  </div>
</footer>
