---
import { type Locale } from '../i18n/locales';
import { t } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const translate = t(locale);

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-brand-800 bg-bg-alt font-mono">
  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
    <!-- Top row: prompt + social links -->
    <div class="mb-4 flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
      <!-- Terminal prompt decoration -->
      <p class="text-sm text-text-muted">
        <span class="text-brand-500">breynerciro@portfolio</span><span class="text-text-muted">:</span><span class="text-accent-500">~</span><span class="text-text-muted">$</span>
        <span class="ml-2 text-brand-400">exit 0</span>
        <span class="ml-1 animate-pulse text-brand-500">_</span>
      </p>

      <!-- Social links -->
      <div class="flex items-center gap-4">
        <a
          href="https://github.com/breynerciro"
          target="_blank"
          rel="noopener noreferrer"
          class="border border-brand-800 px-3 py-1 text-xs text-text-muted transition-all
                 hover:border-brand-500 hover:text-brand-400 hover:shadow-[0_0_8px_rgba(0,255,65,0.2)]"
          aria-label="GitHub"
        >
          [gh]
        </a>
        <a
          href="https://linkedin.com/in/breyner-ciro"
          target="_blank"
          rel="noopener noreferrer"
          class="border border-brand-800 px-3 py-1 text-xs text-text-muted transition-all
                 hover:border-brand-500 hover:text-brand-400 hover:shadow-[0_0_8px_rgba(0,255,65,0.2)]"
          aria-label="LinkedIn"
        >
          [in]
        </a>
        <a
          href="mailto:breynerismael@gmail.com"
          class="border border-brand-800 px-3 py-1 text-xs text-text-muted transition-all
                 hover:border-brand-500 hover:text-brand-400 hover:shadow-[0_0_8px_rgba(0,255,65,0.2)]"
          aria-label="Email"
        >
          [@]
        </a>
      </div>
    </div>

    <!-- Bottom row: copyright + built with -->
    <div class="border-t border-brand-900 pt-4 flex flex-col items-start justify-between gap-2 sm:flex-row sm:items-center">
      <p class="text-xs text-text-muted">
        <span class="text-brand-700">// </span>&copy; {currentYear} Breyner Ciro. {translate('footer.rights')}
      </p>
      <p class="text-xs text-text-muted">
        <span class="text-brand-700">// </span>{translate('footer.built')}
        <span class="ml-1 font-medium text-brand-500">Astro</span>
        <span class="ml-1 text-brand-700">+</span>
        <span class="ml-1 font-medium text-brand-500">Tailwind v4</span>
      </p>
    </div>
  </div>
</footer>
