---
interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
---

<section id={id} class="scroll-mt-16 border-t border-line">
  <div class="mx-auto grid max-w-6xl gap-x-10 gap-y-8 px-5 py-16 sm:px-8 lg:grid-cols-12 lg:py-24">
    <h2 class="font-display text-3xl font-semibold tracking-tight lg:sticky lg:top-24 lg:col-span-4 lg:self-start lg:text-4xl">
      {title}
    </h2>
    <div class="lg:col-span-8">
      <slot />
    </div>
  </div>
</section>
