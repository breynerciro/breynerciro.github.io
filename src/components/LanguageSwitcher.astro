---
import { locales, localeLabels, localeFlags, type Locale } from '../i18n/locales';
import { getRelativeLocaleUrl } from 'astro:i18n';

interface Props {
  currentLocale: Locale;
}

const { currentLocale } = Astro.props;

// Strip locale prefix from current path to get the root path
const pathname = Astro.url.pathname;
const basePath = pathname.replace(/^\/(en|pt)(?=\/|$)/, '') || '/';
---

<div class="relative group">
  <button
    id="lang-toggle"
    type="button"
    aria-label="Change language"
    class="flex items-center gap-1.5 rounded-lg px-3 py-2 text-sm font-medium
           text-text-muted transition-colors hover:bg-surface-200 hover:text-text
           dark:text-surface-300 dark:hover:bg-surface-800"
  >
    <span>{localeFlags[currentLocale]}</span>
    <span class="hidden sm:inline">{localeLabels[currentLocale]}</span>
    <svg
      class="h-3.5 w-3.5 transition-transform group-open:rotate-180"
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      stroke-width="2"
      stroke="currentColor"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
    </svg>
  </button>

  <ul
    id="lang-menu"
    class="absolute right-0 z-50 mt-1 hidden w-40 overflow-hidden rounded-lg border
           border-border bg-bg shadow-lg dark:border-surface-800 dark:bg-surface-900"
  >
    {locales.map((locale) => {
      const url = getRelativeLocaleUrl(locale, basePath, { normalizeLocale: false });
      const isActive = locale === currentLocale;
      return (
        <li>
          <a
            href={url}
            class:list={[
              'flex items-center gap-2 px-3 py-2 text-sm transition-colors',
              isActive
                ? 'bg-brand-100 font-semibold text-brand-700 dark:bg-brand-900/30 dark:text-brand-300'
                : 'text-text-muted hover:bg-surface-100 hover:text-text dark:hover:bg-surface-800',
            ]}
          >
            <span>{localeFlags[locale]}</span>
            <span>{localeLabels[locale]}</span>
          </a>
        </li>
      );
    })}
  </ul>
</div>

<script>
  function initLangSwitcher() {
    const toggle = document.getElementById('lang-toggle');
    const menu = document.getElementById('lang-menu');
    if (!toggle || !menu) return;

    toggle.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = !menu.classList.contains('hidden');
      menu.classList.toggle('hidden', isOpen);
    });

    // Close on outside click
    document.addEventListener('click', (e) => {
      if (!menu.contains(e.target as Node) && e.target !== toggle) {
        menu.classList.add('hidden');
      }
    });
  }

  initLangSwitcher();
  document.addEventListener('astro:after-swap', initLangSwitcher);
</script>
