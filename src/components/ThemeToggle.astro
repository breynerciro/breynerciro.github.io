---
/**
 * Theme toggle button — switches between light/dark mode.
 * Uses localStorage for persistence and respects system preference.
 */
---

<button
  id="theme-toggle"
  type="button"
  aria-label="Toggle theme"
  class="relative flex h-10 w-10 items-center justify-center rounded-lg
         bg-surface-200 text-text-muted transition-colors hover:bg-surface-300
         dark:bg-surface-800 dark:text-surface-300 dark:hover:bg-surface-800/80"
>
  <!-- Sun icon (shown in dark mode) -->
  <svg
    class="h-5 w-5 rotate-0 scale-100 transition-all dark:-rotate-90 dark:scale-0"
    xmlns="http://www.w3.org/2000/svg"
    fill="none"
    viewBox="0 0 24 24"
    stroke-width="1.5"
    stroke="currentColor"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z"
    />
  </svg>

  <!-- Moon icon (shown in light mode) -->
  <svg
    class="absolute h-5 w-5 rotate-90 scale-0 transition-all dark:rotate-0 dark:scale-100"
    xmlns="http://www.w3.org/2000/svg"
    fill="none"
    viewBox="0 0 24 24"
    stroke-width="1.5"
    stroke="currentColor"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z"
    />
  </svg>
</button>

<script>
  function initTheme() {
    const toggle = document.getElementById('theme-toggle');
    if (!toggle) return;

    toggle.addEventListener('click', () => {
      const isDark = document.documentElement.classList.contains('dark');
      const next = isDark ? 'light' : 'dark';

      document.documentElement.classList.toggle('dark', !isDark);
      localStorage.setItem('theme', next);
    });
  }

  // Run on load
  initTheme();
  // Re-run on Astro page transitions
  document.addEventListener('astro:after-swap', initTheme);
</script>
