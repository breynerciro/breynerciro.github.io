---
import { type Locale } from '../../i18n/locales';
import { t, localizedHref } from '../../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const translate = t(locale);

const projectsPath = localizedHref(locale, '/#projects');
const contactPath = localizedHref(locale, '/#contact');
---

<section
  id="home"
  class="relative flex min-h-[85vh] items-center overflow-hidden"
>
  <!-- Background decoration -->
  <div class="pointer-events-none absolute inset-0 -z-10">
    <div
      class="absolute -right-40 -top-40 h-[500px] w-[500px] rounded-full
             bg-brand-400/10 blur-3xl dark:bg-brand-500/5"
    >
    </div>
    <div
      class="absolute -bottom-20 -left-20 h-[300px] w-[300px] rounded-full
             bg-accent-400/10 blur-3xl dark:bg-accent-500/5"
    >
    </div>
  </div>

  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6">
    <div class="max-w-3xl">
      <!-- Greeting -->
      <p class="mb-4 text-sm font-mono text-brand-400">
        <span class="text-text-muted">init@system:~$</span> {translate('hero.greeting')}
      </p>

      <!-- Name -->
      <h1 class="mb-4 text-4xl font-mono font-extrabold tracking-tight sm:text-5xl lg:text-6xl text-text">
        <span class="text-brand-500">></span> {translate('hero.name')}
        <span class="animate-pulse text-brand-500">_</span>
      </h1>

      <!-- Role -->
      <h2 class="mb-4 text-xl font-mono font-bold text-accent-500 sm:text-2xl">
        <span class="opacity-50 text-text-muted">Role: </span>{translate('hero.role')}
      </h2>

      <!-- Subtitle -->
      <p class="mb-8 text-sm md:text-base font-mono text-text-muted">
        // {translate('hero.subtitle')}
      </p>

      <!-- CTAs -->
      <div class="flex flex-wrap gap-4 font-mono">
        <a
          href={projectsPath}
          class="inline-flex items-center gap-2 border border-brand-500 bg-brand-900/30 px-6 py-3
                 text-sm font-bold text-brand-400 shadow-[0_0_15px_rgba(0,255,65,0.2)]
                 transition-all hover:bg-brand-500 hover:text-black hover:shadow-[0_0_20px_rgba(0,255,65,0.5)]"
        >
          > {translate('hero.cta')}
        </a>
        <a
          href={contactPath}
          class="inline-flex items-center gap-2 border border-brand-800 bg-transparent px-6 py-3 
                 text-sm font-bold text-text transition-all hover:border-brand-500 hover:text-brand-400"
        >
          $ {translate('hero.cta secondary')}
        </a>
      </div>

      <!-- Tech stack badges -->
      <div class="mt-12 flex flex-wrap gap-2 font-mono">
        {['Node.js', 'Vue.js', 'PostgreSQL', 'Docker', 'AWS', 'TypeScript'].map((tech) => (
          <span
            class="border border-brand-800 bg-surface-900 px-3 py-1 text-xs font-medium text-brand-400"
          >
            [{tech}]
          </span>
        ))}
      </div>
    </div>
  </div>
</section>
