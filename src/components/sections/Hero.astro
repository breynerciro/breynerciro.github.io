---
import { type Locale } from '../../i18n/locales';
import { t, localizedHref } from '../../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const translate = t(locale);

const projectsPath = localizedHref(locale, '/#projects');
const contactPath  = localizedHref(locale, '/#contact');
---

<section
  id="home"
  class="relative flex min-h-[90vh] items-center overflow-hidden"
>
  <!-- Background: subtle radial glow, no rounded blobs -->
  <div class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_50%_at_50%_-20%,rgba(74,222,128,0.06),transparent)]"></div>
  </div>

  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6">
    <div class="max-w-3xl">

      <!-- Breadcrumb prompt -->
      <p class="mb-6 font-mono text-xs text-[#94a3b8]">
        <span class="text-[#4ade80]">breynerciro@portfolio</span><!-- 
     --><span class="text-[#94a3b8]">:~$</span>
        <span class="ml-1 text-[#e2e8f0]">{translate('hero.greeting')}</span>
      </p>

      <!-- Name — white, large, dominant -->
      <h1 class="mb-3 font-mono text-5xl font-extrabold tracking-tight text-[#f1f5f9] sm:text-6xl lg:text-7xl">
        {translate('hero.name')}<span class="text-[#4ade80] animate-[blink_1.2s_step-end_infinite]">▋</span>
      </h1>

      <!-- Role — accent green, readable size -->
      <h2 class="mb-5 font-mono text-lg font-semibold text-[#4ade80] sm:text-xl">
        // {translate('hero.role')}
      </h2>

      <!-- Subtitle — neutral gray -->
      <p class="mb-10 max-w-2xl font-mono text-sm leading-relaxed text-[#94a3b8] sm:text-base">
        {translate('hero.subtitle')}
      </p>

      <!-- CTAs -->
      <div class="flex flex-wrap gap-4 font-mono">
        <a
          href={projectsPath}
          class="inline-flex items-center gap-2 border border-[#4ade80] bg-[#4ade80]/10 px-6 py-3
                 text-sm font-bold text-[#4ade80] transition-all
                 hover:bg-[#4ade80] hover:text-black"
        >
          <span class="opacity-60">$</span> {translate('hero.cta')}
        </a>
        <a
          href={contactPath}
          class="inline-flex items-center gap-2 border border-[#1e2d1e] bg-transparent px-6 py-3
                 text-sm font-bold text-[#94a3b8] transition-all
                 hover:border-[#4ade80] hover:text-[#e2e8f0]"
        >
          <span class="text-[#4ade80]">→</span> {translate('hero.cta secondary')}
        </a>
      </div>

      <!-- Tech stack badges -->
      <div class="mt-12 flex flex-wrap gap-2 font-mono">
        {['Node.js', 'Vue.js', 'PostgreSQL', 'Docker', 'AWS', 'TypeScript'].map((tech) => (
          <span class="border border-[#1e2d1e] bg-[#0d0d0d] px-3 py-1 text-xs text-[#94a3b8]
                       transition-colors hover:border-[#276749] hover:text-[#e2e8f0]">
            {tech}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0; }
  }
</style>
