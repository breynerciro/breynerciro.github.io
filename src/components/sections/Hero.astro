---
import { type Locale } from '../../i18n/locales';
import { t, localizedHref } from '../../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const translate = t(locale);

const now = {
  es: [
    ['Kila', 'Plataforma SaaS de comercio exterior: agentes de IA, frontend y datos.', 'Trabajo actual'],
    ['BreVenta', 'Punto de venta y facturación electrónica DIAN para varias empresas.', 'Producto propio'],
    ['Denty', 'Gestión de consultorios odontológicos con asistente de WhatsApp.', 'En producción'],
  ],
  en: [
    ['Kila', 'Foreign-trade SaaS platform: AI agents, frontend and data.', 'Current job'],
    ['BreVenta', 'Point of sale and electronic invoicing for multiple companies.', 'Own product'],
    ['Denty', 'Dental practice management with a WhatsApp assistant.', 'In production'],
  ],
  pt: [
    ['Kila', 'Plataforma SaaS de comércio exterior: agentes de IA, frontend e dados.', 'Trabalho atual'],
    ['BreVenta', 'Ponto de venda e faturamento eletrônico para várias empresas.', 'Produto próprio'],
    ['Denty', 'Gestão de consultórios odontológicos com assistente de WhatsApp.', 'Em produção'],
  ],
}[locale];
const sceneLabels = { es: 'Interfaz,API,IA,Datos,Nube', en: 'Interface,API,AI,Data,Cloud', pt: 'Interface,API,IA,Dados,Nuvem' }[locale];
const hrefs = ['/#experience', '/projects/breventa/', '/projects/denty/'].map((h) => localizedHref(locale, h));
---

<!-- Escena 3D fija detrás de la página: las capas de un producto, de la interfaz a la nube.
     Se iluminan las capas que toca lo que se está leyendo (elementos con data-layers). -->
<canvas id="scene" aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10 h-full w-full"></canvas>
<div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10 hidden overflow-hidden lg:block">
  {sceneLabels.split(',').map((label) => (
    <span data-scene-label class="absolute left-0 top-0 text-sm font-semibold opacity-0">{label}</span>
  ))}
</div>

<!-- El color de la franja va en ::before (z -20) para que la escena (z -10) quede entre el fondo y el texto -->
<section id="home" class="on-band relative text-white before:absolute before:inset-0 before:-z-20 before:bg-band">
  <div class="mx-auto max-w-6xl px-5 pb-12 pt-16 sm:px-8 lg:pb-16 lg:pt-24">
    <p class="enter mb-6 flex flex-wrap gap-x-3 text-lg sm:text-xl">
      <span class="font-bold">{translate('hero.name')}</span>
      <span class="text-white/80">{translate('hero.role')}</span>
    </p>

    <h1 style="--i:1" class="enter max-w-5xl text-balance font-display text-[clamp(2.5rem,7vw,5.5rem)] lg:max-w-[60%] lg:text-[clamp(3rem,4.6vw,4.5rem)] font-semibold leading-[0.98] tracking-[-0.03em]">
      {translate('hero.subtitle')}
    </h1>

    <div style="--i:3" class="enter mt-10 flex flex-wrap gap-3">
      <a href={localizedHref(locale, '/#projects')} class="btn btn-solid">{translate('hero.cta')}</a>
      <a href={localizedHref(locale, '/cv/')} class="btn">
        {translate('cv.download')}
      </a>
      <a href={localizedHref(locale, '/#contact')} class="btn">{translate('hero.cta secondary')}</a>
    </div>

    <!-- En pantallas angostas la escena 3D ocupa este espacio en vez de ir detrás del texto -->
    <div id="scene-slot" class="mt-8 h-80 lg:hidden"></div>

    <div style="--i:5" class="enter mt-8 lg:mt-24">
      <h2 class="mb-3 text-sm font-semibold text-white/80">{translate('hero.now')}</h2>
      <ul class="border-t border-white/30">
        {now.map(([name, what, status], i) => (
          <li class="border-b border-white/30">
            <a href={hrefs[i]} class="group grid gap-x-8 gap-y-1 py-4 sm:grid-cols-12 sm:items-baseline">
              <span class="font-display text-2xl font-semibold sm:col-span-3">{name}</span>
              <span class="text-white/90 decoration-mark decoration-2 underline-offset-4 group-hover:underline sm:col-span-6">{what}</span>
              <span class="text-sm text-white/75 sm:col-span-3 sm:text-right">{status}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>
  // three.js se carga aparte, después del primer pintado; sin WebGL la página queda igual, sin escena.
  const canvas = document.getElementById('scene') as HTMLCanvasElement | null;
  const hero = document.getElementById('home');
  if (canvas && hero) {
    import('../../scripts/scene')
      .then((m) => m.start(canvas, hero, [...document.querySelectorAll<HTMLElement>('[data-scene-label]')]))
      .catch(() => canvas.remove());
  }
</script>
