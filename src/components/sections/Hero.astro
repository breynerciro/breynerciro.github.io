---
import { type Locale } from '../../i18n/locales';
import { t, localizedHref } from '../../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const translate = t(locale);

const projectsPath = localizedHref(locale, '/#projects');
const contactPath = localizedHref(locale, '/#contact');
---

<section
  id="home"
  class="relative flex min-h-[85vh] items-center overflow-hidden"
>
  <!-- Background decoration -->
  <div class="pointer-events-none absolute inset-0 -z-10">
    <div
      class="absolute -right-40 -top-40 h-[500px] w-[500px] rounded-full
             bg-brand-400/10 blur-3xl dark:bg-brand-500/5"
    >
    </div>
    <div
      class="absolute -bottom-20 -left-20 h-[300px] w-[300px] rounded-full
             bg-accent-400/10 blur-3xl dark:bg-accent-500/5"
    >
    </div>
  </div>

  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6">
    <div class="max-w-3xl">
      <!-- Greeting -->
      <p class="mb-4 text-lg font-medium text-brand-500">
        {translate('hero.greeting')}
      </p>

      <!-- Name -->
      <h1 class="mb-4 text-4xl font-extrabold tracking-tight sm:text-5xl lg:text-6xl">
        <span class="text-text">{translate('hero.name')}</span>
        <span class="text-brand-500">.</span>
      </h1>

      <!-- Role -->
      <h2 class="mb-4 text-2xl font-bold text-text sm:text-3xl">
        {translate('hero.role')}
      </h2>

      <!-- Subtitle -->
      <p class="mb-8 text-lg text-text-muted">
        {translate('hero.subtitle')}
      </p>

      <!-- CTAs -->
      <div class="flex flex-wrap gap-4">
        <a
          href={projectsPath}
          class="inline-flex items-center gap-2 rounded-xl bg-brand-500 px-6 py-3
                 text-sm font-semibold text-white shadow-lg shadow-brand-500/25
                 transition-all hover:bg-brand-600 hover:shadow-brand-500/40"
        >
          {translate('hero.cta')}
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
        <a
          href={contactPath}
          class="inline-flex items-center gap-2 rounded-xl border border-border
                 bg-bg px-6 py-3 text-sm font-semibold text-text transition-all
                 hover:border-brand-300 hover:bg-surface-100
                 dark:border-surface-700 dark:hover:border-brand-700 dark:hover:bg-surface-800"
        >
          {translate('hero.cta secondary')}
        </a>
      </div>

      <!-- Tech stack badges -->
      <div class="mt-12 flex flex-wrap gap-2">
        {['Node.js', 'Vue.js', 'PostgreSQL', 'Docker', 'AWS', 'TypeScript'].map((tech) => (
          <span
            class="rounded-lg bg-surface-200 px-3 py-1.5 text-xs font-medium text-text-muted
                   dark:bg-surface-800 dark:text-surface-300"
          >
            {tech}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>
