---
import { type Locale } from '../../i18n/locales';
import { t } from '../../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const translate = t(locale);

const stats = [
  { value: '3+', key: 'about.stat experience' },
  { value: '5+', key: 'about.stat projects' },
  { value: '100%', key: 'about.stat clients' },
];
---

<section id="about" class="scroll-mt-20 py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <!-- Section header -->
    <div class="mb-12 font-mono">
      <p class="mb-2 text-xs text-text-muted">
        <span class="text-brand-500">breynerciro@portfolio</span><span class="text-text-muted">:</span><span class="text-accent-500">~</span><span class="text-text-muted">$</span>
      </p>
      <h2 class="text-3xl font-bold tracking-tight text-text sm:text-4xl">
        <span class="text-brand-500">></span> ./whoami.sh
        <span class="animate-pulse text-brand-500">_</span>
      </h2>
      <p class="mt-2 text-sm text-text-muted">// {translate('about.title')}</p>
    </div>

    <div class="grid gap-12 lg:grid-cols-5">
      <!-- Text content -->
      <div class="terminal-window lg:col-span-3">
        <div class="terminal-header">
          <div class="flex gap-1.5">
            <div class="terminal-dot active"></div>
            <div class="terminal-dot"></div>
            <div class="terminal-dot"></div>
          </div>
          <span class="ml-2 text-xs font-mono text-text-muted">~/about/README.md</span>
        </div>
        <div class="space-y-4 p-6 font-mono">
          <p class="text-xs text-text-muted mb-4">
            <span class="text-brand-500">$</span> cat README.md
          </p>
          <p class="text-sm leading-relaxed text-text-muted">
            {translate('about.p1')}
          </p>
          <p class="text-sm leading-relaxed text-text-muted">
            {translate('about.p2')}
          </p>
        </div>
      </div>

      <!-- Stats -->
      <div class="flex flex-col gap-4 lg:col-span-2">
        {stats.map((stat) => (
          <div class="terminal-window transition-all hover:shadow-[0_0_20px_rgba(0,255,65,0.15)]">
            <div class="terminal-header">
              <div class="flex gap-1.5">
                <div class="terminal-dot active"></div>
                <div class="terminal-dot"></div>
                <div class="terminal-dot"></div>
              </div>
              <span class="ml-2 text-xs font-mono text-text-muted">stat</span>
            </div>
            <div class="p-5 font-mono">
              <div class="text-4xl font-extrabold text-brand-500 shadow-[0_0_10px_rgba(0,255,65,0.3)]">
                {stat.value}
              </div>
              <div class="mt-2 text-xs font-medium text-text-muted">
                <span class="text-brand-500">// </span>{translate(stat.key)}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
