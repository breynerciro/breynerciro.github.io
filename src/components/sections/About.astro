---
import { type Locale } from '../../i18n/locales';
import { t } from '../../i18n/utils';
import Section from '../Section.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const translate = t(locale);
---

<Section id="about" title={translate('about.title')}>
  <div class="max-w-[62ch] space-y-5 text-lg leading-relaxed sm:text-xl">
    <p>{translate('about.p1')}</p>
    <p class="text-muted">{translate('about.p2')}</p>
  </div>
</Section>
