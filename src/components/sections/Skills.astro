---
import { type Locale } from '../../i18n/locales';
import { t } from '../../i18n/utils';
import Section from '../Section.astro';
import { skillGroups } from '../../utils/profile';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const translate = t(locale);

const groups = skillGroups(locale);
---

<Section id="skills" title={translate('skills.title')}>
  <dl class="-mt-5">
    {groups.map((group) => (
      <div data-layers={group.layer} class="grid gap-x-8 gap-y-1 border-b border-line py-5 last:border-b-0 last:pb-0 sm:grid-cols-4">
        <dt class="font-semibold">{translate(group.titleKey)}</dt>
        <dd class="leading-relaxed text-muted sm:col-span-3">{group.skills.join(', ')}</dd>
      </div>
    ))}
  </dl>
</Section>
