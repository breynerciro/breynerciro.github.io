---
import { type Locale } from '../../i18n/locales';
import { t } from '../../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const translate = t(locale);

const skillGroups = [
  {
    titleKey: 'skills.backend',
    file: 'backend',
    skills: [
      { name: 'Node.js / Express',     level: 95 },
      { name: 'Python (FastAPI/Django)', level: 85 },
      { name: 'REST APIs / Webhooks',   level: 92 },
      { name: 'Vert.x',                level: 75 },
    ],
  },
  {
    titleKey: 'skills.databases',
    file: 'databases',
    skills: [
      { name: 'PostgreSQL', level: 90 },
      { name: 'MySQL',      level: 88 },
      { name: 'MongoDB',    level: 80 },
      { name: 'Redis',      level: 75 },
    ],
  },
  {
    titleKey: 'skills.frontend',
    file: 'frontend',
    skills: [
      { name: 'React / React Native',   level: 90 },
      { name: 'Vue.js (Vue 2/3)',        level: 92 },
      { name: 'TypeScript / JS (ES6+)', level: 90 },
      { name: 'Tailwind CSS',           level: 88 },
      { name: 'Expo',                   level: 85 },
      { name: 'Pinia / Vuex',           level: 85 },
    ],
  },
  {
    titleKey: 'skills.devops',
    file: 'devops',
    skills: [
      { name: 'Docker / Compose',     level: 90 },
      { name: 'AWS',                  level: 85 },
      { name: 'CI/CD & GitHub Actions', level: 85 },
      { name: 'Nginx',                level: 80 },
      { name: 'Microservices Arch.',  level: 88 },
      { name: 'Edge Computing',       level: 75 },
    ],
  },
  {
    titleKey: 'skills.methods',
    file: 'methods',
    skills: [
      { name: 'Scrum',        level: 90 },
      { name: 'GitFlow',      level: 90 },
      { name: 'Code Reviews', level: 88 },
      { name: 'Clean Code',   level: 88 },
    ],
  },
  {
    titleKey: 'skills.languages',
    file: 'languages',
    skills: [
      { name: 'Inglés (B1)',    level: 70 },
      { name: 'Portugués (B1)', level: 70 },
    ],
  },
];
---

<section id="skills" class="scroll-mt-20 py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">

    <!-- Section header -->
    <div class="mb-12 font-mono">
      <p class="mb-1 text-xs text-[#94a3b8]">
        <span class="text-[#4ade80]">breynerciro@portfolio</span><span class="text-[#94a3b8]">:~/skills$</span>
      </p>
      <h2 class="text-3xl font-bold text-[#f1f5f9] sm:text-4xl">
        <span class="text-[#4ade80]">./skills</span>
        <span class="animate-[blink_1.2s_step-end_infinite] text-[#4ade80]">▋</span>
      </h2>
      <p class="mt-1 text-xs text-[#94a3b8]">// {translate('skills.title')}</p>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      {skillGroups.map((group) => (
        <div class="terminal-window">
          <!-- macOS title bar -->
          <div class="terminal-header">
            <div class="flex gap-1.5">
              <span class="terminal-dot dot-red"></span>
              <span class="terminal-dot dot-yellow"></span>
              <span class="terminal-dot dot-green"></span>
            </div>
            <span class="ml-2 text-xs font-mono text-[#94a3b8]">
              ~/skills/{group.file}.log
            </span>
          </div>

          <div class="p-5">
            <!-- Group title -->
            <h3 class="mb-5 font-mono text-sm font-bold text-[#4ade80]">
              {translate(group.titleKey)}
            </h3>

            <!-- Skill bars -->
            <div class="space-y-4">
              {group.skills.map((skill) => (
                <div class="font-mono">
                  <div class="mb-1.5 flex items-center justify-between gap-2">
                    <span class="text-sm text-[#e2e8f0]">{skill.name}</span>
                    <span class="flex-shrink-0 text-xs font-semibold text-[#4ade80]">
                      {skill.level}%
                    </span>
                  </div>
                  <!-- Progress bar -->
                  <div class="h-1.5 overflow-hidden bg-[#0d0d0d] border border-[#1e2d1e]">
                    <div
                      class="h-full bg-[#4ade80] transition-all duration-1000"
                      style={`width: ${skill.level}%`}
                    ></div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0; }
  }
</style>
