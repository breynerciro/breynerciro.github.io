---
import { type Locale } from '../../i18n/locales';
import { t } from '../../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const translate = t(locale);

const skillGroups = [
  {
    titleKey: 'skills.backend',
    icon: 'server',
    skills: [
      { name: 'Node.js / Express', level: 95 },
      { name: 'Python (FastAPI/Django)', level: 85 },
      { name: 'REST APIs / Webhooks', level: 92 },
      { name: 'Vert.x', level: 75 },
    ],
  },
  {
    titleKey: 'skills.databases',
    icon: 'database',
    skills: [
      { name: 'PostgreSQL', level: 90 },
      { name: 'MySQL', level: 88 },
      { name: 'MongoDB', level: 80 },
      { name: 'Redis', level: 75 },
    ],
  },
  {
    titleKey: 'skills.frontend',
    icon: 'layout',
    skills: [
      { name: 'React / React Native', level: 90 },
      { name: 'Vue.js (Vue 2/3)', level: 92 },
      { name: 'TypeScript / JS (ES6+)', level: 90 },
      { name: 'Tailwind CSS', level: 88 },
      { name: 'Expo', level: 85 },
      { name: 'Pinia / Vuex', level: 85 },
    ],
  },
  {
    titleKey: 'skills.devops',
    icon: 'cloud',
    skills: [
      { name: 'Docker / Compose', level: 90 },
      { name: 'AWS', level: 85 },
      { name: 'CI/CD & GitHub Actions', level: 85 },
      { name: 'Nginx', level: 80 },
      { name: 'Microservices Arch.', level: 88 },
      { name: 'Edge Computing', level: 75 },
    ],
  },
  {
    titleKey: 'skills.methods',
    icon: 'check',
    skills: [
      { name: 'Scrum', level: 90 },
      { name: 'GitFlow', level: 90 },
      { name: 'Code Reviews', level: 88 },
      { name: 'Clean Code', level: 88 },
    ],
  },
  {
    titleKey: 'skills.languages',
    icon: 'message-circle',
    skills: [
      { name: 'Inglés (B1)', level: 70 },
      { name: 'Portugués (B1)', level: 70 },
    ],
  },
];
---

<section id="skills" class="scroll-mt-20 py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <!-- Section header -->
    <div class="mb-12 font-mono">
      <h2 class="text-3xl font-bold tracking-tight text-text sm:text-4xl">
        <span class="text-brand-500">></span> ./run_skills.sh
        <span class="animate-pulse text-brand-500">_</span>
      </h2>
    </div>

    <div class="grid gap-8 md:grid-cols-2">
      {skillGroups.map((group) => (
        <div class="terminal-window">
          <div class="terminal-header">
            <div class="flex gap-1.5">
              <div class="terminal-dot active"></div>
              <div class="terminal-dot"></div>
              <div class="terminal-dot"></div>
            </div>
            <span class="ml-2 text-xs font-mono text-text-muted">~/skills/{translate(group.titleKey).toLowerCase().replace(/ & | /g, '_')}</span>
          </div>
          <div class="p-6">
            <h3 class="mb-5 text-lg font-mono font-bold text-brand-400">
              $ cat {translate(group.titleKey).toLowerCase().replace(/ & | /g, '_')}.txt
            </h3>
            <div class="space-y-4">
              {group.skills.map((skill) => (
                <div class="font-mono">
                  <div class="mb-1.5 flex items-center justify-between">
                    <span class="text-sm font-medium text-text">{skill.name}</span>
                    <span class="text-xs font-medium text-brand-500">[{skill.level}%]</span>
                  </div>
                  <div class="h-2 overflow-hidden bg-surface-900 border border-brand-800">
                    <div
                      class="h-full bg-brand-500 shadow-[0_0_10px_rgba(0,255,65,0.5)] transition-all duration-1000"
                      style={`width: ${skill.level}%`}
                    >
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
