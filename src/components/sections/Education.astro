---
import { type Locale } from '../../i18n/locales';
import { t } from '../../i18n/utils';
import { getLocalized, formatDate } from '../../utils/content';
import Section from '../Section.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const translate = t(locale);
const certs = (await getLocalized('certifications', locale)).sort(
  (a, b) => b.data.issuedDate.valueOf() - a.data.issuedDate.valueOf(),
);

const degrees = [
  ['Ingeniería de Sistemas y Computación', 'Universidad Nacional de Colombia', '2018 – 2026'],
  ['Técnico Laboral en Sistemas Informáticos', 'POLINTEC', '2016'],
];
---

<Section id="education" title={translate('education.title')}>
  <h3 class="mb-2 text-sm font-semibold text-muted">{translate('education.degree')}</h3>
  <ul class="mb-12 border-t border-line">
    {degrees.map(([title, school, years]) => (
      <li class="grid gap-x-8 border-b border-line py-4 sm:grid-cols-4 sm:items-baseline">
        <div class="sm:col-span-3">
          <p class="font-display text-xl font-semibold tracking-tight">{title}</p>
          <p class="text-muted">{school}</p>
        </div>
        <p class="text-sm text-muted sm:text-right">{years}</p>
      </li>
    ))}
  </ul>

  <h3 class="mb-2 text-sm font-semibold text-muted">{translate('education.certs')}</h3>
  <ul class="border-t border-line">
    {certs.map((cert) => (
      <li class="grid gap-x-8 border-b border-line py-4 last:border-b-0 sm:grid-cols-4 sm:items-baseline">
        <div class="sm:col-span-3">
          <p class="font-semibold">
            {cert.data.credentialUrl ? (
              <a href={cert.data.credentialUrl} target="_blank" rel="noopener noreferrer" class="link">{cert.data.title}</a>
            ) : (
              cert.data.title
            )}
          </p>
          <p class="text-muted">{cert.data.issuer}</p>
        </div>
        <p class="text-sm text-muted sm:text-right">{formatDate(cert.data.issuedDate, locale)}</p>
      </li>
    ))}
  </ul>
</Section>
