---
import { type Locale } from '../../i18n/locales';
import { t } from '../../i18n/utils';
import { getLocalized, formatDate } from '../../utils/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const translate = t(locale);
const experiences = await getLocalized('experience', locale);
---

<section id="experience" class="scroll-mt-20 py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <!-- Section header -->
    <div class="mb-12">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
        {translate('experience.title')}
        <span class="ml-2 text-brand-500">.</span>
      </h2>
    </div>

    {experiences.length > 0 ? (
      <div class="relative space-y-0">
        <!-- Timeline line -->
        <div
          class="absolute left-4 top-0 h-full w-px bg-border dark:bg-surface-800
                 sm:left-6"
        >
        </div>

        {experiences.map((exp, i) => (
          <div class="relative flex gap-6 pb-10 last:pb-0">
            <!-- Timeline dot -->
            <div class="relative z-10 flex-shrink-0">
              <div
                class:list={[
                  'flex h-8 w-8 items-center justify-center rounded-full border-2 sm:h-12 sm:w-12',
                  i === 0
                    ? 'border-brand-500 bg-brand-100 dark:bg-brand-900/30'
                    : 'border-border bg-bg dark:border-surface-700',
                ]}
              >
                <div
                  class:list={[
                    'h-3 w-3 rounded-full',
                    i === 0 ? 'bg-brand-500' : 'bg-surface-300 dark:bg-surface-600',
                  ]}
                >
                </div>
              </div>
            </div>

            <!-- Content -->
            <div
              class="flex-1 rounded-2xl border border-border bg-bg-alt p-6
                     transition-colors hover:border-brand-300
                     dark:border-surface-800 dark:hover:border-brand-700"
            >
              <div class="mb-2 flex flex-wrap items-center gap-2">
                <h3 class="text-lg font-bold text-text">{exp.data.role}</h3>
                {exp.data.current && (
                  <span
                    class="rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-semibold
                           text-green-700 dark:bg-green-900/30 dark:text-green-400"
                  >
                    {translate('experience.current')}
                  </span>
                )}
              </div>

              <p class="mb-1 text-sm font-semibold text-brand-500">{exp.data.company}</p>
              {exp.data.location && (
                <p class="mb-3 text-xs text-text-muted">{exp.data.location}</p>
              )}

              <p class="mb-4 text-xs text-text-muted">
                {formatDate(exp.data.startDate, locale)} —{' '}
                {exp.data.endDate ? formatDate(exp.data.endDate, locale) : translate('experience.present')}
              </p>

              {exp.data.highlights.length > 0 && (
                <ul class="space-y-2">
                  {exp.data.highlights.map((h) => (
                    <li class="flex items-start gap-2 text-sm text-text-muted">
                      <svg
                        class="mt-0.5 h-4 w-4 flex-shrink-0 text-brand-500"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="2"
                        stroke="currentColor"
                      >
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                      </svg>
                      <span>{h}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </div>
        ))}
      </div>
    ) : (
      <p class="text-text-muted">No experience entries for this language yet.</p>
    )}
  </div>
</section>
