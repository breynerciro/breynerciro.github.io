---
import { type Locale } from '../../i18n/locales';
import { t } from '../../i18n/utils';
import { getLocalized, formatDate } from '../../utils/content';
import { layersOf } from '../../utils/layers';
import Section from '../Section.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const translate = t(locale);
// Más reciente primero (las entradas no tienen pubDate, así que se ordenan aquí)
const experiences = (await getLocalized('experience', locale)).sort(
  (a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf(),
);
---

<Section id="experience" title={translate('experience.title')}>
  <ol class="-mt-8">
    {experiences.map((exp) => (
      <li data-layers={layersOf(exp.data.tags)} class="border-b border-line py-8 last:border-b-0 last:pb-0">
        <p class="mb-2 flex flex-wrap items-center gap-x-3 text-sm text-muted">
          <span>
            {formatDate(exp.data.startDate, locale)} –{' '}
            {exp.data.endDate ? formatDate(exp.data.endDate, locale) : translate('experience.present')}
          </span>
          {exp.data.location && <span>{exp.data.location}</span>}
          {exp.data.current && (
            <span class="inline-flex items-center gap-1.5 font-semibold text-text">
              <span class="h-2 w-2 rounded-full bg-mark" aria-hidden="true"></span>
              {translate('experience.current')}
            </span>
          )}
        </p>
        <h3 class="font-display text-2xl font-semibold tracking-tight">{exp.data.role}</h3>
        <p class="mb-4 font-semibold text-accent">{exp.data.company}</p>
        <ul class="max-w-[70ch] list-disc space-y-2 pl-5 leading-relaxed marker:text-accent">
          {exp.data.highlights.map((h) => <li>{h}</li>)}
        </ul>
      </li>
    ))}
  </ol>
</Section>
