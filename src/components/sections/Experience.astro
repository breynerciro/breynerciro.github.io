---
import { type Locale } from '../../i18n/locales';
import { t } from '../../i18n/utils';
import { getLocalized, formatDate } from '../../utils/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const translate = t(locale);
const experiences = await getLocalized('experience', locale);
---

<section id="experience" class="scroll-mt-20 py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <!-- Section header -->
    <div class="mb-12 font-mono">
      <p class="mb-2 text-xs text-text-muted">
        <span class="text-brand-500">breynerciro@portfolio</span><span class="text-text-muted">:</span><span class="text-accent-500">~/experience</span><span class="text-text-muted">$</span>
      </p>
      <h2 class="text-3xl font-bold tracking-tight text-text sm:text-4xl">
        <span class="text-brand-500">></span> ./show_experience.sh
        <span class="animate-pulse text-brand-500">_</span>
      </h2>
      <p class="mt-2 text-sm text-text-muted">// {translate('experience.title')}</p>
    </div>

    {experiences.length > 0 ? (
      <div class="relative space-y-0">
        <!-- Timeline line -->
        <div
          class="absolute left-4 top-0 h-full w-px border-l border-dashed border-brand-800
                 sm:left-6"
        >
        </div>

        {experiences.map((exp, i) => (
          <div class="relative flex gap-6 pb-10 last:pb-0">
            <!-- Timeline dot -->
            <div class="relative z-10 flex-shrink-0">
              <div
                class:list={[
                  'flex h-8 w-8 items-center justify-center border font-mono text-xs sm:h-12 sm:w-12',
                  i === 0
                    ? 'border-brand-500 bg-brand-950 text-brand-500 shadow-[0_0_10px_rgba(0,255,65,0.3)]'
                    : 'border-brand-800 bg-bg text-brand-800',
                ]}
              >
                {i === 0 ? '>' : String(i + 1).padStart(2, '0')}
              </div>
            </div>

            <!-- Content: terminal window card -->
            <div class="terminal-window flex-1 transition-all hover:shadow-[0_0_20px_rgba(0,255,65,0.1)]">
              <!-- Terminal header bar -->
              <div class="terminal-header">
                <div class="flex gap-1.5">
                  <div class:list={['terminal-dot', i === 0 ? 'active' : '']}></div>
                  <div class="terminal-dot"></div>
                  <div class="terminal-dot"></div>
                </div>
                <span class="ml-2 flex-1 text-xs font-mono text-text-muted truncate">
                  ~/experience/{exp.data.company.toLowerCase().replace(/\s+/g, '-')}
                </span>
                {exp.data.current && (
                  <span class="border border-brand-500 px-2 py-0.5 text-xs font-mono text-brand-500 shadow-[0_0_5px_rgba(0,255,65,0.3)]">
                    {translate('experience.current')}
                  </span>
                )}
              </div>

              <!-- Card body -->
              <div class="p-5 font-mono">
                <div class="mb-1 text-xs text-text-muted">
                  <span class="text-brand-500">$</span> cat job.md
                </div>
                <h3 class="mb-1 text-base font-bold text-brand-400"># {exp.data.role}</h3>
                <p class="mb-1 text-sm font-semibold text-accent-500">@ {exp.data.company}</p>

                {exp.data.location && (
                  <p class="mb-2 text-xs text-text-muted">// {exp.data.location}</p>
                )}

                <p class="mb-4 text-xs text-text-muted border-l-2 border-brand-800 pl-3">
                  {formatDate(exp.data.startDate, locale)} —{' '}
                  {exp.data.endDate ? formatDate(exp.data.endDate, locale) : translate('experience.present')}
                </p>

                {exp.data.highlights.length > 0 && (
                  <ul class="space-y-2">
                    {exp.data.highlights.map((h) => (
                      <li class="flex items-start gap-2 text-sm text-text-muted">
                        <span class="mt-0.5 flex-shrink-0 text-brand-500">{'>'}</span>
                        <span>{h}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <p class="font-mono text-sm text-text-muted">
        <span class="text-brand-500">></span> No output. No experience entries for this language yet.
      </p>
    )}
  </div>
</section>
