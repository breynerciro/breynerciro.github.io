---
import { type Locale } from '../../i18n/locales';
import { t } from '../../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const translate = t(locale);

const contactLinks = [
  {
    key: 'contact.email',
    value: 'breynerismael@gmail.com',
    href: 'mailto:breynerismael@gmail.com',
    icon: 'mail',
  },
  {
    key: 'contact.linkedin',
    value: 'linkedin.com/in/breyner-ciro',
    href: 'https://linkedin.com/in/breyner-ciro',
    icon: 'linkedin',
    external: true,
  },
  {
    key: 'contact.github',
    value: 'github.com/breynerciro',
    href: 'https://github.com/breynerciro',
    icon: 'github',
    external: true,
  },
  {
    key: 'contact.location',
    value: translate('contact.locationValue'),
    href: '#',
    icon: 'map',
  },
];
---

<section id="contact" class="scroll-mt-20 py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <!-- Section header -->
    <div class="mb-12 font-mono text-center">
      <p class="mb-2 text-xs text-text-muted">
        <span class="text-brand-500">breynerciro@portfolio</span><span class="text-text-muted">:</span><span class="text-accent-500">~/contact</span><span class="text-text-muted">$</span>
      </p>
      <h2 class="text-3xl font-bold tracking-tight text-text sm:text-4xl">
        <span class="text-brand-500">></span> ./contact.sh
        <span class="animate-pulse text-brand-500">_</span>
      </h2>
      <p class="mt-3 text-sm text-text-muted">// {translate('contact.subtitle')}</p>
    </div>

    <div class="mx-auto grid max-w-2xl gap-4 sm:grid-cols-2">
      {contactLinks.map((link) => (
        <a
          href={link.href}
          target={link.external ? '_blank' : undefined}
          rel={link.external ? 'noopener noreferrer' : undefined}
          class="terminal-window group flex items-center gap-4 p-5 transition-all
                 hover:shadow-[0_0_20px_rgba(0,255,65,0.15)]"
        >
          <!-- Icon area: terminal prompt style -->
          <div class="flex-shrink-0 font-mono text-brand-500 text-lg w-8 text-center">
            {link.icon === 'mail' && '@'}
            {link.icon === 'linkedin' && 'in'}
            {link.icon === 'github' && 'gh'}
            {link.icon === 'map' && '>>'}
          </div>

          <!-- Text -->
          <div class="min-w-0 font-mono">
            <p class="text-xs font-medium text-text-muted">
              <span class="text-brand-500">$</span> {translate(link.key).toLowerCase()}
            </p>
            <p class="mt-0.5 truncate text-sm font-semibold text-brand-400 group-hover:text-brand-300 transition-colors">
              {link.value}
            </p>
          </div>

          <!-- Arrow -->
          {link.external && (
            <span class="ml-auto flex-shrink-0 text-xs text-text-muted group-hover:text-brand-500 transition-colors">
              →
            </span>
          )}
        </a>
      ))}
    </div>
  </div>
</section>
