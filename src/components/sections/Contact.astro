---
import { type Locale } from '../../i18n/locales';
import { t } from '../../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const translate = t(locale);

const contactLinks = [
  {
    key: 'contact.email',
    label: 'email',
    value: 'breynerismael@gmail.com',
    href: 'mailto:breynerismael@gmail.com',
    prefix: '@',
  },
  {
    key: 'contact.linkedin',
    label: 'linkedin',
    value: 'linkedin.com/in/breyner-ciro',
    href: 'https://linkedin.com/in/breyner-ciro',
    prefix: 'in',
    external: true,
  },
  {
    key: 'contact.github',
    label: 'github',
    value: 'github.com/breynerciro',
    href: 'https://github.com/breynerciro',
    prefix: 'gh',
    external: true,
  },
  {
    key: 'contact.location',
    label: 'location',
    value: translate('contact.locationValue'),
    href: '#',
    prefix: '>>',
  },
];
---

<section id="contact" class="scroll-mt-20 py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">

    <!-- Section header -->
    <div class="mb-12 font-mono text-center">
      <p class="mb-1 text-xs text-[#94a3b8]">
        <span class="text-[#4ade80]">breynerciro@portfolio</span><span class="text-[#94a3b8]">:~/contact$</span>
      </p>
      <h2 class="text-3xl font-bold text-[#f1f5f9] sm:text-4xl">
        <span class="text-[#4ade80]">./contact</span>
        <span class="animate-[blink_1.2s_step-end_infinite] text-[#4ade80]">▋</span>
      </h2>
      <p class="mt-2 text-sm text-[#94a3b8]">{translate('contact.subtitle')}</p>
    </div>

    <div class="mx-auto grid max-w-2xl gap-4 sm:grid-cols-2">
      {contactLinks.map((link) => (
        <a
          href={link.href}
          target={link.external ? '_blank' : undefined}
          rel={link.external ? 'noopener noreferrer' : undefined}
          class="terminal-window group flex items-center gap-4 p-5 transition-all
                 hover:border-[#276749]"
        >
          <!-- Monospace prefix badge -->
          <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center border border-[#1e2d1e]
                      font-mono text-xs font-bold text-[#4ade80] transition-colors
                      group-hover:border-[#4ade80]">
            {link.prefix}
          </div>

          <!-- Label + value -->
          <div class="min-w-0 font-mono">
            <p class="text-xs text-[#94a3b8]">{link.label}</p>
            <p class="mt-0.5 truncate text-sm font-semibold text-[#e2e8f0] transition-colors
                      group-hover:text-[#4ade80]">
              {link.value}
            </p>
          </div>

          {link.external && (
            <span class="ml-auto flex-shrink-0 text-xs text-[#94a3b8] transition-colors
                         group-hover:text-[#4ade80]">→</span>
          )}
        </a>
      ))}
    </div>

  </div>
</section>

<style>
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0; }
  }
</style>
