---
import { locales, localeLabels, type Locale } from '../../i18n/locales';
import { t } from '../../i18n/utils';
import Section from '../Section.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const translate = t(locale);
const cv = (l: Locale) => `/cv/breyner-ciro-cv-${l}.pdf`;
---

<Section id="contact" title={translate('contact.title')}>
  <p class="mb-3 text-lg text-muted sm:text-xl">{translate('contact.subtitle')}</p>
  <a
    href="mailto:breynerismael@gmail.com"
    class="font-display text-[clamp(1.5rem,4.5vw,3rem)] font-semibold tracking-tight underline decoration-mark decoration-[3px] underline-offset-[6px] [overflow-wrap:anywhere] hover:text-accent"
  >
    breynerismael@gmail.com
  </a>

  <ul class="mt-10 flex flex-wrap gap-x-6 gap-y-2">
    <li><a href="https://www.linkedin.com/in/breyner-ciro-38011330b/" target="_blank" rel="noopener noreferrer" class="link">LinkedIn</a></li>
    <li><a href="https://github.com/breynerciro" target="_blank" rel="noopener noreferrer" class="link">GitHub</a></li>
    <li class="text-muted">{translate('contact.locationValue')}</li>
  </ul>

  <p class="mt-6 text-muted">
    {translate('cv.download')} (PDF):{' '}
    {locales.map((l, i) => (
      <>{i > 0 && ' / '}<a href={cv(l)} download hreflang={l} class="link">{localeLabels[l]}</a></>
    ))}
  </p>
</Section>
