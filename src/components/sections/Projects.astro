---
import { type Locale } from '../../i18n/locales';
import { t } from '../../i18n/utils';
import { getLocalized } from '../../utils/content';
import ProjectCard from '../cards/ProjectCard.astro';
import Section from '../Section.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const translate = t(locale);
const projects = await getLocalized('projects', locale);
---

<Section id="projects" title={translate('projects.title')}>
  <div class="-mt-8">
    {projects.map((project) => <ProjectCard project={project} locale={locale} />)}
  </div>
</Section>
