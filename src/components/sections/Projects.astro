---
import { type Locale } from '../../i18n/locales';
import { t } from '../../i18n/utils';
import { getLocalized } from '../../utils/content';
import ProjectCard from '../cards/ProjectCard.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const translate = t(locale);
const projects = await getLocalized('projects', locale);
---

<section id="projects" class="scroll-mt-20 py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">

    <!-- Section header -->
    <div class="mb-12 font-mono">
      <p class="mb-1 text-xs text-[#94a3b8]">
        <span class="text-[#4ade80]">breynerciro@portfolio</span><span class="text-[#94a3b8]">:~/projects$</span>
      </p>
      <h2 class="text-3xl font-bold text-[#f1f5f9] sm:text-4xl">
        <span class="text-[#4ade80]">./projects</span>
        <span class="animate-[blink_1.2s_step-end_infinite] text-[#4ade80]">▋</span>
      </h2>
      <p class="mt-1 text-xs text-[#94a3b8]">// {translate('projects.title')}</p>
    </div>

    {projects.length > 0 ? (
      <div class="grid gap-6 sm:grid-cols-2">
        {projects.map((project) => (
          <ProjectCard project={project} locale={locale} />
        ))}
      </div>
    ) : (
      <p class="font-mono text-sm text-[#94a3b8]">
        <span class="text-[#4ade80]">›</span> No projects for this language yet.
      </p>
    )}

  </div>
</section>

<style>
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0; }
  }
</style>
