---
import { type Locale } from '../../i18n/locales';
import { t, localizedHref } from '../../i18n/utils';
import { slugFromId } from '../../utils/content';
import { layersOf } from '../../utils/layers';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  locale: Locale;
}

const { project, locale } = Astro.props;
const translate = t(locale);
const { data } = project;
const detailUrl = localizedHref(locale, `/projects/${slugFromId(project.id)}/`);
---

<article data-layers={layersOf(data.stack)} class="group relative border-b border-line py-8 last:border-b-0 last:pb-0">
  <p class="mb-1 text-sm text-muted">{data.pubDate.getUTCFullYear()}</p>
  <h3 class="font-display text-2xl font-semibold tracking-tight sm:text-3xl">
    <a href={detailUrl} class="decoration-mark decoration-[3px] underline-offset-4 after:absolute after:inset-0 group-hover:underline">
      {data.title}
    </a>
  </h3>
  <p class="mt-3 max-w-[70ch] leading-relaxed">{data.description}</p>
  <p class="mt-3 max-w-[70ch] text-sm text-muted">{data.stack.join(', ')}</p>
  <p class="relative z-10 mt-4 flex flex-wrap gap-x-5 gap-y-1 text-sm">
    <a href={detailUrl} class="link">{translate('projects.caseStudy')}</a>
    {data.repoUrl && (
      <a href={data.repoUrl} target="_blank" rel="noopener noreferrer" class="link">{translate('projects.viewCode')}</a>
    )}
    {data.demoUrl && (
      <a href={data.demoUrl} target="_blank" rel="noopener noreferrer" class="link">{translate('projects.viewLive')}</a>
    )}
  </p>
</article>
