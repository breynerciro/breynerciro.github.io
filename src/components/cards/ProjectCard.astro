---
import { type Locale } from '../../i18n/locales';
import { t } from '../../i18n/utils';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  locale: Locale;
}

const { project, locale } = Astro.props;
const translate = t(locale);
const { data } = project;
---

<article
  class="group flex flex-col rounded-2xl border border-border bg-bg-alt p-6
         transition-all hover:border-brand-300 hover:shadow-lg hover:shadow-brand-500/5
         dark:border-surface-800 dark:hover:border-brand-700"
>
  <!-- Header -->
  <div class="mb-4 flex items-start justify-between">
    <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-100
                dark:bg-brand-900/30">
      <svg
        class="h-5 w-5 text-brand-600 dark:text-brand-400"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
      </svg>
    </div>

    <div class="flex gap-2">
      {data.repoUrl && (
        <a
          href={data.repoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-text-muted transition-colors hover:text-brand-500"
          aria-label={translate('projects.viewCode')}
        >
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
          </svg>
        </a>
      )}
      {data.demoUrl && (
        <a
          href={data.demoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-text-muted transition-colors hover:text-brand-500"
          aria-label={translate('projects.viewLive')}
        >
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
          </svg>
        </a>
      )}
    </div>
  </div>

  <!-- Title & Description -->
  <h3 class="mb-2 text-lg font-bold text-text group-hover:text-brand-500 transition-colors">
    {data.title}
  </h3>
  <p class="mb-4 flex-1 text-sm leading-relaxed text-text-muted">
    {data.description}
  </p>

  <!-- Stack tags -->
  {data.stack.length > 0 && (
    <div class="flex flex-wrap gap-1.5">
      {data.stack.map((s) => (
        <span
          class="rounded-md bg-surface-200 px-2 py-0.5 text-xs font-medium text-text-muted
                 dark:bg-surface-800"
        >
          {s}
        </span>
      ))}
    </div>
  )}
</article>
