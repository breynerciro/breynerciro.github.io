---
import { type Locale } from '../i18n/locales';
import { t, localizedHref } from '../i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const translate = t(locale);

const navLinks = [
  { key: 'nav.about',      href: localizedHref(locale, '/#about') },
  { key: 'nav.experience', href: localizedHref(locale, '/#experience') },
  { key: 'nav.projects',   href: localizedHref(locale, '/#projects') },
  { key: 'nav.skills',     href: localizedHref(locale, '/#skills') },
  { key: 'nav.education',  href: localizedHref(locale, '/#education') },
  { key: 'nav.blog',       href: localizedHref(locale, '/blog/') },
  { key: 'nav.contact',    href: localizedHref(locale, '/#contact') },
];

const homePath = localizedHref(locale, '/');
---

<header class="sticky top-0 z-50 border-b border-line bg-bg/90 backdrop-blur-md">
  <nav class="mx-auto flex h-14 max-w-6xl items-center justify-between gap-4 px-5 sm:px-8">
    <a href={homePath} class="font-display text-lg font-bold tracking-tight">Breyner Ciro</a>

    <ul class="hidden items-center gap-5 lg:flex">
      {navLinks.map((link) => (
        <li>
          <a href={link.href} class="text-sm font-medium text-muted transition-colors hover:text-text">
            {translate(link.key)}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-1">
      <LanguageSwitcher currentLocale={locale} />
      <ThemeToggle />
      <button
        id="mobile-menu-toggle"
        type="button"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="flex h-10 w-10 items-center justify-center rounded-full text-muted transition-colors hover:text-text lg:hidden"
      >
        <svg id="icon-menu" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
          <path stroke-linecap="round" d="M3.75 7.5h16.5M3.75 16.5h16.5" />
        </svg>
        <svg id="icon-close" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
          <path stroke-linecap="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-line px-5 pb-4 pt-2 lg:hidden">
    <ul>
      {navLinks.map((link) => (
        <li>
          <a href={link.href} class="block py-2.5 font-display text-xl font-semibold">
            {translate(link.key)}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  function initMobileMenu() {
    const toggle = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const iconMenu = document.getElementById('icon-menu');
    const iconClose = document.getElementById('icon-close');
    if (!toggle || !menu) return;

    const setOpen = (open: boolean) => {
      menu.classList.toggle('hidden', !open);
      iconMenu?.classList.toggle('hidden', open);
      iconClose?.classList.toggle('hidden', !open);
      toggle.setAttribute('aria-expanded', String(open));
    };

    toggle.addEventListener('click', () => setOpen(menu.classList.contains('hidden')));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  }

  initMobileMenu();
  document.addEventListener('astro:after-swap', initMobileMenu);
</script>
