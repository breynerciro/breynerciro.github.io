---
import { type Locale } from '../i18n/locales';
import { t, localizedHref } from '../i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const translate = t(locale);

const navLinks = [
  { key: 'nav.about',      href: localizedHref(locale, '/#about') },
  { key: 'nav.skills',     href: localizedHref(locale, '/#skills') },
  { key: 'nav.experience', href: localizedHref(locale, '/#experience') },
  { key: 'nav.projects',   href: localizedHref(locale, '/#projects') },
  { key: 'nav.education',  href: localizedHref(locale, '/#education') },
  { key: 'nav.blog',       href: localizedHref(locale, '/blog/') },
  { key: 'nav.contact',    href: localizedHref(locale, '/#contact') },
];

const homePath = localizedHref(locale, '/');
---

<header
  class="sticky top-0 z-50 border-b border-[#1e2d1e] bg-[#0d0d0d]/95 backdrop-blur-md"
>
  <nav class="mx-auto flex h-14 max-w-6xl items-center justify-between px-4 sm:px-6">

    <!-- Logo -->
    <a
      href={homePath}
      class="font-mono text-sm font-bold tracking-tight transition-colors
             hover:opacity-80"
    >
      <span class="text-[#4ade80]">breynerciro</span><!-- 
   --><span class="text-[#94a3b8]">@</span><!-- 
   --><span class="text-[#e2e8f0]">portfolio</span><!-- 
   --><span class="text-[#4ade80] animate-pulse">▋</span>
    </a>

    <!-- Desktop nav -->
    <ul class="hidden items-center gap-0.5 md:flex">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class="relative px-3 py-2 text-xs font-mono text-[#94a3b8] transition-colors
                   hover:text-[#e2e8f0]
                   after:absolute after:bottom-0 after:left-3 after:right-3 after:h-px
                   after:bg-[#4ade80] after:scale-x-0 after:transition-transform
                   hover:after:scale-x-100"
          >
            {translate(link.key)}
          </a>
        </li>
      ))}
    </ul>

    <!-- Actions -->
    <div class="flex items-center gap-2">
      <LanguageSwitcher currentLocale={locale} />

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-toggle"
        type="button"
        aria-label="Open menu"
        class="flex h-9 w-9 items-center justify-center border border-[#1e2d1e]
               text-[#94a3b8] transition-colors hover:border-[#276749] hover:text-[#e2e8f0]
               md:hidden"
      >
        <svg id="icon-menu" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="square" stroke-linejoin="miter" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
        <svg id="icon-close" class="hidden h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="square" stroke-linejoin="miter" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden border-t border-[#1e2d1e] bg-[#0d0d0d] px-4 pb-4 pt-2 md:hidden"
  >
    <!-- Terminal-style path -->
    <p class="mb-2 text-xs font-mono text-[#94a3b8]">
      <span class="text-[#4ade80]">breynerciro@portfolio</span>
      <span class="text-[#94a3b8]">:~$</span>
      <span class="ml-1 text-[#e2e8f0]">ls -1</span>
    </p>
    <ul class="space-y-0.5">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class="flex items-center gap-2 px-2 py-2 text-sm font-mono text-[#94a3b8]
                   transition-colors hover:text-[#e2e8f0]"
          >
            <span class="text-[#4ade80] text-xs">→</span>
            {translate(link.key)}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  function initMobileMenu() {
    const toggle  = document.getElementById('mobile-menu-toggle');
    const menu    = document.getElementById('mobile-menu');
    const iconMenu  = document.getElementById('icon-menu');
    const iconClose = document.getElementById('icon-close');
    if (!toggle || !menu) return;

    toggle.addEventListener('click', () => {
      const isOpen = !menu.classList.contains('hidden');
      menu.classList.toggle('hidden');
      iconMenu?.classList.toggle('hidden', !isOpen);
      iconClose?.classList.toggle('hidden', isOpen);
    });

    menu.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', () => {
        menu.classList.add('hidden');
        iconMenu?.classList.remove('hidden');
        iconClose?.classList.add('hidden');
      });
    });
  }

  initMobileMenu();
  document.addEventListener('astro:after-swap', initMobileMenu);
</script>
