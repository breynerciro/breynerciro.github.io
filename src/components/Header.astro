---
import { type Locale } from '../i18n/locales';
import { t, localizedHref } from '../i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const translate = t(locale);

const navLinks = [
  { key: 'nav.about', href: localizedHref(locale, '/#about') },
  { key: 'nav.skills', href: localizedHref(locale, '/#skills') },
  { key: 'nav.experience', href: localizedHref(locale, '/#experience') },
  { key: 'nav.projects', href: localizedHref(locale, '/#projects') },
  { key: 'nav.education', href: localizedHref(locale, '/#education') },
  { key: 'nav.blog', href: localizedHref(locale, '/blog/') },
  { key: 'nav.contact', href: localizedHref(locale, '/#contact') },
];

const homePath = localizedHref(locale, '/');
---

<header
  class="sticky top-0 z-50 border-b border-brand-800/50 bg-surface-900/90 backdrop-blur-lg
         supports-[backdrop-filter]:bg-surface-950/80"
>
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <!-- Logo -->
    <a
      href={homePath}
      class="text-sm md:text-base font-mono font-bold tracking-tight text-brand-500 transition-colors hover:text-brand-400"
    >
      breyner@ciro<span class="text-text-muted">:</span><span class="text-accent-500">~</span><span class="text-text-muted">$</span>
    </a>

    <!-- Desktop nav -->
    <ul class="hidden items-center gap-1 md:flex">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class="rounded-sm px-3 py-2 text-sm font-mono text-text transition-colors
                   hover:bg-brand-900 hover:text-brand-400"
          >
            {translate(link.key)}
          </a>
        </li>
      ))}
    </ul>

    <!-- Actions -->
    <div class="flex items-center gap-2">
      <LanguageSwitcher currentLocale={locale} />

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-toggle"
        type="button"
        aria-label="Open menu"
        class="flex h-10 w-10 items-center justify-center rounded-lg text-text-muted
               transition-colors hover:bg-surface-200 hover:text-text
               dark:hover:bg-surface-800 md:hidden"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden border-t border-brand-800 bg-surface-900 px-4 pb-4 pt-2 md:hidden"
  >
    <ul class="space-y-1">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class="block rounded-sm px-3 py-2 text-sm font-mono text-text
                   transition-colors hover:bg-brand-900 hover:text-brand-400"
          >
            > {translate(link.key)}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  function initMobileMenu() {
    const toggle = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-menu');
    if (!toggle || !menu) return;

    toggle.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });

    // Close on link click
    menu.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', () => menu.classList.add('hidden'));
    });
  }

  initMobileMenu();
  document.addEventListener('astro:after-swap', initMobileMenu);
</script>
