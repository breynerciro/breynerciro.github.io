---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogCard from '../../../components/cards/BlogCard.astro';
import { getLocalized } from '../../../utils/content';
import { t } from '../../../i18n/utils';

const locale = 'en' as const;
const translate = t(locale);
const posts = await getLocalized('blog', locale);
---

<BaseLayout
  locale={locale}
  title="Blog — Breyner Ciro"
  description="Articles about fullstack development, Node.js, Vue.js, Docker and software architecture."
  canonicalPath="/blog/"
>
  <section class="py-20">
    <div class="mx-auto max-w-6xl px-5 sm:px-8">
      <!-- Section header -->
      <div class="mb-12">
        <h1 class="font-display text-4xl font-semibold tracking-tight sm:text-5xl">
          {translate('blog.title')}
        </h1>
      </div>

      {posts.length > 0 ? (
        <div class="border-t border-line">
          {posts.map((post) => (
            <BlogCard post={post} locale={locale} />
          ))}
        </div>
      ) : (
        <p class="text-muted">{translate('blog.noPosts')}</p>
      )}
    </div>
  </section>
</BaseLayout>
