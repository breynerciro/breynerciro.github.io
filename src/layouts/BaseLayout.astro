---
import type { Locale } from "../i18n/locales";
import { defaultLocale } from "../i18n/locales";
import { buildSEO } from "../utils/seo";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  locale?: Locale;
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalPath?: string;
}

const {
  locale = defaultLocale,
  title = "Breyner Ciro — Ingeniero de Software FullStack",
  description = "Portafolio de Breyner Ciro, ingeniero de software FullStack: producto SaaS con Vue, React, Node.js y GCP/AWS, e IA aplicada a flujos reales de negocio.",
  ogImage,
  canonicalPath = "/",
} = Astro.props;

const siteUrl = (Astro.site?.toString() ?? "https://breynerciro.github.io").replace(/\/+$/, "");
const seo = buildSEO({ title, description, canonicalPath, ogImage, locale }, siteUrl);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta -->
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <meta name="author" content="Breyner Ciro" />

    <meta name="theme-color" content="#1c1f23" />
    <meta property="og:site_name" content="Breyner Ciro" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        name: "Breyner Ismael Ciro Otero",
        alternateName: "Breyner Ciro",
        jobTitle: "FullStack Software Engineer",
        url: `${siteUrl}/`,
        sameAs: [
          "https://github.com/breynerciro",
          "https://www.linkedin.com/in/breyner-ciro-38011330b/",
        ],
        alumniOf: {
          "@type": "CollegeOrUniversity",
          name: "Universidad Nacional de Colombia",
        },
        worksFor: { "@type": "Organization", name: "Kila" },
        address: {
          "@type": "PostalAddress",
          addressLocality: "Bogotá",
          addressCountry: "CO",
        },
        knowsAbout: [
          "TypeScript",
          "Vue",
          "React",
          "Node.js",
          "Google Cloud",
          "LLM agents",
          "Model Context Protocol",
          "PostgreSQL",
          "Supabase",
        ],
      })}
    />

    <!-- Canonical -->
    <link rel="canonical" href={seo.canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={seo.ogUrl} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:image" content={seo.ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:locale"
      content={locale === "es" ? "es_CO" : locale === "pt" ? "pt_BR" : "en_US"}
    />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={seo.ogImage} />

    <!-- Hreflang alternates -->
    {
      seo.hreflangs.map(({ locale: l, url }) => (
        <link rel="alternate" hreflang={l} href={url} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={seo.xDefault} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Preconnect fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Instrument+Sans:wght@400..700&family=JetBrains+Mono&display=swap"
      rel="stylesheet"
    />

    <!-- Tema: el guardado, o el del sistema; antes de pintar para que no parpadee -->
    <script is:inline>
      (function () {
        var saved = null;
        try { saved = localStorage.getItem("theme"); } catch (e) {}
        var dark = saved ? saved === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", dark);
      })();
    </script>
  </head>

  <body class="min-h-screen bg-bg text-text antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-2 focus:top-2 focus:z-50 focus:bg-mark focus:px-3 focus:py-2 focus:text-[#1c1f23]"
      >Skip to content</a
    >
    <Header locale={locale} />

    <main id="main">
      <slot />
    </main>

    <Footer locale={locale} />
  </body>
</html>
