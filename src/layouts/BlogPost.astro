---
import type { Locale } from '../i18n/locales';
import { t, localizedHref } from '../i18n/utils';
import { slugFromId, formatDate } from '../utils/content';
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import BaseLayout from './BaseLayout.astro';

interface Props {
  entry: CollectionEntry<'blog'>;
  locale: Locale;
}

const { entry, locale } = Astro.props;
const translate = t(locale);
const { Content } = await render(entry);
const { data } = entry;
const slug = slugFromId(entry.id);
const canonicalPath = `/blog/${slug}`;
---

<BaseLayout
  locale={locale}
  title={data.title}
  description={data.description}
  canonicalPath={canonicalPath}
>
  <article class="py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <!-- Back link -->
      <a
        href={localizedHref(locale, '/blog/')}
        class="mb-8 inline-flex items-center gap-1 text-sm font-medium text-text-muted transition-colors hover:text-brand-500"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
        </svg>
        {translate('blog.backToBlog')}
      </a>

      <!-- Header -->
      <header class="mb-10">
        {data.tags.length > 0 && (
          <div class="mb-4 flex flex-wrap gap-1.5">
            {data.tags.map((tag) => (
              <span
                class="rounded-md bg-brand-100 px-2 py-0.5 text-xs font-semibold text-brand-700
                       dark:bg-brand-900/30 dark:text-brand-300"
              >
                #{tag}
              </span>
            ))}
          </div>
        )}

        <h1 class="text-3xl font-bold tracking-tight text-text sm:text-4xl">
          {data.title}
        </h1>

        <div class="mt-4 flex items-center gap-2 text-sm text-text-muted">
          <span class="font-medium text-text">Breyner Ciro</span>
          <span aria-hidden="true">·</span>
          <time datetime={data.pubDate.toISOString()}>
            {translate('blog.publishedOn')} {formatDate(data.pubDate, locale)}
          </time>
          {data.readingTime && (
            <>
              <span aria-hidden="true">·</span>
              <span>{data.readingTime} {translate('blog.readTime')}</span>
            </>
          )}
        </div>
      </header>

      <!-- Body -->
      <div class="prose prose-neutral dark:prose-invert max-w-none">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>
