---
import type { Locale } from '../i18n/locales';
import { t, localizedHref } from '../i18n/utils';
import { slugFromId } from '../utils/content';
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import BaseLayout from './BaseLayout.astro';

interface Props {
  entry: CollectionEntry<'projects'>;
  locale: Locale;
}

const { entry, locale } = Astro.props;
const translate = t(locale);
const { Content } = await render(entry);
const { data } = entry;
const links = [
  data.repoUrl && { label: translate('projects.viewCode'), url: data.repoUrl },
  ...data.extraRepos.map((r) => ({ label: `${translate('projects.viewCode')} · ${r.label}`, url: r.url })),
  data.demoUrl && { label: translate('projects.viewLive'), url: data.demoUrl },
].filter(Boolean) as { label: string; url: string }[];
---

<BaseLayout
  locale={locale}
  title={`${data.title} — Breyner Ciro`}
  description={data.description}
  canonicalPath={`/projects/${slugFromId(entry.id)}/`}
>
  <article class="py-12 lg:py-16">
    <div class="mx-auto max-w-3xl px-5 sm:px-8">
      <a href={localizedHref(locale, '/#projects')} class="link mb-8 inline-block text-sm">
        {translate('projects.back')}
      </a>

      <header class="mb-10 border-b border-line pb-8">
        <h1 class="mb-4 text-balance font-display text-4xl font-semibold leading-tight tracking-tight sm:text-5xl">{data.title}</h1>
        <p class="mb-5 text-lg leading-relaxed text-muted">{data.description}</p>
        <p class="text-sm"><span class="font-semibold">{translate('projects.stack')}:</span> <span class="text-muted">{data.stack.join(', ')}</span></p>
        {links.length > 0 && (
          <div class="mt-6 flex flex-wrap gap-3">
            {links.map((l) => (
              <a href={l.url} target="_blank" rel="noopener noreferrer" class="btn">{l.label}</a>
            ))}
          </div>
        )}
      </header>

      <div class="prose max-w-none">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>
